# Base de données PostgreSQL (Neon, Supabase, ou autre)
# DATABASE_URL : connexion utilisée par l'application (via le pooler Neon,
# host se terminant par "-pooler").
# DIRECT_URL : connexion directe (host SANS "-pooler"), utilisée uniquement
# par les commandes `prisma migrate` — les migrations sont des opérations
# longues (ALTER TABLE...) que le pooler peut interrompre en cours de route,
# laissant une migration bloquée "en échec" sur la base. Sur Neon, les deux
# URLs sont visibles dans Dashboard > Connection Details (bouton "Pooled
# connection" à décocher pour obtenir la version directe).
DATABASE_URL="postgresql://user:password@host-pooler:5432/nova?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/nova?schema=public"

# NextAuth
NEXTAUTH_SECRET="generer-avec-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Anthropic (appel serveur uniquement, jamais exposé au client)
ANTHROPIC_API_KEY="sk-ant-..."

# Transcription audio (rapports vocaux terrain) — console.groq.com
GROQ_API_KEY=""

# Envoi d'email (rapport stratégique) — resend.com
RESEND_API_KEY=""
EMAIL_FROM="Nova <rapports@votredomaine.fr>"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ESSENTIEL="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_PREMIUM="price_..."

# Notifications push (PWA) — générer une paire avec `npx web-push generate-vapid-keys`.
# La clé publique est exposée au client (NEXT_PUBLIC_), nécessaire pour l'abonnement.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Rate limiting (voir lib/rateLimit.ts — implémentation mémoire par défaut,
# recommandé de passer sur Upstash Redis en production)
